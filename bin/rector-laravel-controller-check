#!/usr/bin/env php
<?php

declare(strict_types=1);

use Jcergolj\RectorForLaravel\Diagnostics\ControllerRouteDiagnostic;

if ($argc !== 2 || ! is_dir($argv[1])) {
    fwrite(STDERR, "Usage: rector-laravel-controller-check <laravel-project-directory>\n");
    exit(2);
}

require $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';

try {
    $diagnostics = (new ControllerRouteDiagnostic)->inspect($argv[1]);
} catch (PhpParser\Error $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(2);
}

foreach ($diagnostics as $diagnostic) {
    fwrite(STDOUT, $diagnostic."\n");
}

exit($diagnostics === [] ? 0 : 1);
